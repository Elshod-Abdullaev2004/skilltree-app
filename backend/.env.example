# Порт запуска Express-сервера
PORT=5000

# Строка подключения к MongoDB (локальная БД или MongoDB Atlas)
# Пример для локальной MongoDB: mongodb://127.0.0.1:27017/skilltree
# Пример для MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/skilltree?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/skilltree

# URL фронтенда Next.js для настройки CORS
FRONTEND_URL=http://localhost:3000
